# Local development database used by docker-compose.yml
# Copy this file to .env (cp .env.example .env) and adjust values if needed.
POSTGRES_DB=saldo
POSTGRES_USER=saldo
POSTGRES_PASSWORD=saldo
POSTGRES_PORT=5432
# JWT signing secret: Base64 of at least 32 random bytes, e.g. generated by: openssl rand -base64 48
# Left empty on purpose: the backend refuses to start until you set it in your local .env.
JWT_SECRET=
# Gemini API key from Google AI Studio. Optional: without it AI calls fail fast and callers use their keyword fallback.
# Free plan: use fake data only. Enable Cloud Billing before deploying with real user data.
GEMINI_API_KEY=
